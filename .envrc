source_env_if_exists .envrc.local

# Ignore local env files that are not already covered by .gitignore.
# Create .gitignore when env files exist and the repo has none.
# .env.example stays trackable as the committed template.
for _env_file in .env .env.*; do
  [ -e "$_env_file" ] || continue
  [ "$_env_file" = ".env.example" ] && continue
  if [ ! -f .gitignore ] || ! git check-ignore -q -- "$_env_file" 2>/dev/null; then
    printf '%s\n' "$_env_file" >> .gitignore
  fi
done
unset _env_file

# .envrc and .infisical.yaml are meant to be committed.
# Warn when gitignore covers them. A scan exit of 1 means secrets were found.
_safe_ignored=""
for _safe_file in .envrc .infisical.yaml; do
  if [ -f .gitignore ] && git check-ignore -q -- "$_safe_file" 2>/dev/null; then
    _safe_ignored="${_safe_ignored} ${_safe_file}"
  fi
done
if [ -n "$_safe_ignored" ]; then
  _scan_status=0
  infisical scan --no-git --no-color >/dev/null 2>&1 || _scan_status=$?
  if [ "$_scan_status" -eq 1 ]; then
    log_error "${_safe_ignored# } are in .gitignore and are not safe to commit; infisical scan found secrets"
  else
    log_error "${_safe_ignored# } are in .gitignore, but they are safe to commit"
  fi
fi
unset _safe_file _safe_ignored _scan_status
# # dotenv-eval is Infisical's shell-safe export format; load all dev secrets.
# Load the actual environment
if ! _infisical_exports="$(infisical export --format=dotenv-eval --silent)"; then
  unset _infisical_exports
  log_error "Infisical export failed; project credentials were not loaded"
  return 1
fi

if ! eval "$_infisical_exports"; then
  unset _infisical_exports
  log_error "Infisical environment could not be loaded"
  return 1
fi
if ! [ -f ".env.example" ]; then
     _infisical_example_exports="$(infisical secrets generate-example-env)"
     if ! eval "$(echo "$_infisical_example_exports" > .env.example)"; then
        unset _infisical_example_exports
        log_error "Infisical example environment could not be generated"
        return 1
    fi
    unset _infisical_example_exports
    return 0
fi
unset _infisical_exports
