{
  "name": "@fullsnacklab/tsconfig",
  "description": "Shared typeScript configurations with DOM, library, and opt-in React presets",
  "version": "2.0.9",
  "scripts": {
    "release": "bunx bumpp --commit --push --tag"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/full-snack-lab/tsconfig.git"
  },
  "author": {
    "name": "Jordan Sweeting",
    "email": "jordan@fullsnacklab.com",
    "url": "https://fullsnacklab.com"
  },
  "license": "MIT",
  "files": [
    "package.json",
    "dom",
    "no-dom"
  ],
  "exports": {
    ".": "./base.json",
    "./package.json": "./package.json",
    "./dom": "./dom/base.json",
    "./dom/app": "./dom/app.json",
    "./dom/library": "./dom/library.json",
    "./dom/extends/app": "./dom/extends/app/base.json",
    "./dom/extends/library": "./dom/extends/library/base.json",
    "./no-dom": "./no-dom/base.json",
    "./no-dom/library": "./no-dom/library.json",
    "./no-dom/app": "./no-dom/app.json",
    "./no-dom/extends/app": "./no-dom/extends/app/base.json",
    "./no-dom/extends/library": "./no-dom/extends/library/base.json"
  },
  "packageManager": "bun@1.4.3",
  "publishConfig": {
    "access": "public"
  }
}
